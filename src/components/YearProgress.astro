<div
  id="year-progress"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-live="polite"
  aria-label="本年度已过时间比例"
>
  <div id="year-progress-track">
    <div class="year-progress-rail">
      <div id="year-progress-fill"></div>
    </div>
    <span id="year-progress-label"></span>
  </div>
</div>

<script>
  function yearProgress(): {
    pct: number;
    elapsedDays: number;
    remainingDays: number;
  } {
    const now = new Date();
    const year = now.getFullYear();
    const start = new Date(year, 0, 1);
    const end = new Date(year + 1, 0, 1);
    const elapsedDays =
      Math.floor(
        (Date.UTC(year, now.getMonth(), now.getDate()) -
          Date.UTC(year, 0, 1)) /
          86_400_000
      ) + 1;
    const daysInYear = Math.round(
      (end.getTime() - start.getTime()) / 86_400_000
    );
    const pct = Math.min(
      1,
      Math.max(0, (now.getTime() - start.getTime()) / (end.getTime() - start.getTime()))
    );
    return {
      pct,
      elapsedDays,
      remainingDays: daysInYear - elapsedDays,
    };
  }

  function initYearProgress(): void {
    const root = document.getElementById("year-progress");
    const track = document.getElementById("year-progress-track");
    const fill = document.getElementById("year-progress-fill");
    const label = document.getElementById("year-progress-label");
    if (!root || !track || !fill || !label || track.dataset.bound) return;

    const { pct, elapsedDays, remainingDays } = yearProgress();
    const percentage = (pct * 100).toFixed(1) + "%";
    const tip = `已过 ${elapsedDays} 天，剩余 ${remainingDays} 天`;
    fill.style.width = percentage;
    label.textContent = percentage;
    root.setAttribute("title", tip);
    track.setAttribute("title", tip);
    root.setAttribute("aria-label", `本年度进度 ${percentage}，${tip}`);
    root.setAttribute("aria-valuenow", String(Math.round(pct * 100)));

    const placeLabel = () => {
      const cw = track.offsetWidth;
      const lw = label.offsetWidth || 0;
      label.style.left = Math.min(cw * pct + 3, Math.max(0, cw - lw)) + "px";
    };
    placeLabel();

    track.addEventListener("mouseenter", () => {
      placeLabel();
      label.classList.add("year-progress-visible");
    });
    track.addEventListener("mouseleave", () => {
      label.classList.remove("year-progress-visible");
    });

    track.dataset.bound = "1";
  }

  initYearProgress();
</script>
